name: ES2017 PR Lint

on:
  pull_request:

permissions:
  contents: read       # Needed to checkout code and get diffs
  pull-requests: write # Needed for Reviewdog to post PR comments

jobs:
  lint-es2017:
    runs-on: ubuntu-latest

    steps:
      # 1. Checkout the PR branch
      - uses: actions/checkout@v4

      # 2. Set up Node.js
      - name: Setup Node.js
        uses: actions/setup-node@v3
        with:
          node-version: 20

      # 3. Install ESLint, plugin, globals, and reviewdog temporarily
      - name: Install ESLint & plugins
        run: |
          npm init -y
          npm install eslint eslint-plugin-es globals reviewdog

      # 4. Create ESLint config enforcing ES2017
      - name: Create ESLint config
        run: |
          echo 'module.exports = {
            parserOptions: { ecmaVersion: 2017 },
            plugins: ["es"],
            rules: {
              "es/no-new-in-es2018": "error",
              "es/no-new-in-es2019": "error",
              "es/no-new-in-es2020": "error",
              "es/no-new-in-es2021": "error",
              "es/no-new-in-es2022": "error",
              "es/no-new-in-es2023": "error"
            },
            globals: require("globals").es2017
          };' > .eslintrc.js

      # 5. Run ESLint and filter to PR changes using Reviewdog
      - name: Lint changed lines in PR
        run: |
          npx eslint . -f unix | npx reviewdog \
            -f=eslint \
            -reporter=github-pr-check \
            -filter-mode=diff_context
        env:
          REVIEWDOG_GITHUB_API_TOKEN: ${{ secrets.GITHUB_TOKEN }}
